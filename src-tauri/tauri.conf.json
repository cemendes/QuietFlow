{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "QuietFlow",
  "version": "0.1.0-alpha.4",
  "identifier": "com.quietflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuietFlow",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxQTY2MkQ3NjgxMDUyMEUKUldRT1VoQm8xMkttc2FSSjdaVXIzNDYrL0RNdWNubkJkcUFxY3Y0VCsvWXpwZ0xSNWs5TFVwOU8K",
      "endpoints": [
        "https://github.com/cemendes/QuietFlow/releases/latest/download/latest.json"
      ]
    }
  }
}
